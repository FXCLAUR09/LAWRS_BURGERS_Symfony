{% extends 'Admin/base.html.twig' %}

{% block title %}Staff Dashboard | Lawr's Burgers{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'Staff/sidebar.html.twig' %}
    <main class="admin-main">
        <header class="admin-topbar">
            <div><div class="breadcrumb">STAFF / DASHBOARD</div><h1>Operations Dashboard</h1></div>
            <div class="admin-user"><div class="user-avatar">{{ staff.name|slice(0, 1)|upper }}</div><div class="user-info"><strong>{{ staff.name }}</strong><span>Staff Member</span></div></div>
        </header>

        <section class="welcome-banner">
            <div class="welcome-content"><p class="welcome-small">LAWR'S BURGERS OPERATIONS</p><h2>Welcome back, {{ staff.name }}!</h2><p>Here's today's operations snapshot. Let's keep every order moving.</p></div>
            <div class="welcome-burger">🍔</div>
        </section>

        <section class="stats-grid">
            <div class="stat-card"><div class="stat-icon orange">🍔</div><div class="stat-content"><span class="stat-label">TOTAL BURGERS</span><strong class="stat-number">{{ stats.burgers }}</strong><span class="stat-description">Menu inventory items</span></div></div>
            <div class="stat-card"><div class="stat-icon burgundy">🛒</div><div class="stat-content"><span class="stat-label">TOTAL ORDERS</span><strong class="stat-number">{{ stats.orders }}</strong><span class="stat-description">All recorded orders</span></div></div>
            <div class="stat-card"><div class="stat-icon green">⌛</div><div class="stat-content"><span class="stat-label">PENDING ORDERS</span><strong class="stat-number">{{ stats.pending }}</strong><span class="stat-description">Needs staff attention</span></div></div>
            <div class="stat-card"><div class="stat-icon dark">★</div><div class="stat-content"><span class="stat-label">CUSTOMER REVIEWS</span><strong class="stat-number">{{ stats.reviews }}</strong><span class="stat-description">Submitted feedback</span></div></div>
        </section>

        <section class="lb-analytics-grid">
            <article class="lb-panel lb-chart-panel"><div class="lb-panel-heading"><div><span class="lb-eyebrow">STORE PERFORMANCE</span><h2>Sales Overview</h2><p>Daily sales for the last seven days</p></div><span class="lb-live-tag">LIVE DATA</span></div><div class="lb-chart-wrap"><canvas id="lbSalesChart"></canvas></div></article>
            <article class="lb-panel lb-status-panel"><div class="lb-panel-heading"><div><span class="lb-eyebrow">ORDER BREAKDOWN</span><h2>Order Status</h2><p>Current order distribution</p></div></div><div class="lb-doughnut-wrap"><canvas id="lbOrdersChart"></canvas></div><div class="lb-chart-legend" id="lbOrderLegend"></div></article>
        </section>

        <section class="lb-progress-grid">
            <article class="lb-panel lb-progress-card"><div class="lb-ring" style="--ring-value: {{ completion_rate }}; --ring-color: #6f8b3a"><div><strong>{{ completion_rate }}%</strong><span>Completed</span></div></div><div class="lb-progress-copy"><span class="lb-eyebrow">ORDER PERFORMANCE</span><h3>Order Completion</h3><p>Orders marked completed or delivered.</p></div></article>
            <article class="lb-panel lb-progress-card"><div class="lb-ring" style="--ring-value: {{ availability_rate }}; --ring-color: #ff9100"><div><strong>{{ availability_rate }}%</strong><span>Available</span></div></div><div class="lb-progress-copy"><span class="lb-eyebrow">INVENTORY HEALTH</span><h3>Burger Availability</h3><p>Share of burger items currently available.</p></div></article>
            <article class="lb-panel lb-progress-card"><div class="lb-ring" style="--ring-value: {{ pending_rate }}; --ring-color: #641c1c"><div><strong>{{ pending_rate }}%</strong><span>Pending</span></div></div><div class="lb-progress-copy"><span class="lb-eyebrow">NEEDS ATTENTION</span><h3>Pending Orders</h3><p>{{ stats.pending }} orders are waiting for action.</p></div></article>
        </section>

        <section class="dashboard-grid">
            <div class="dashboard-card orders-card">
                <div class="card-header"><div><span class="card-label">ORDER MANAGEMENT</span><h2>Recent Orders</h2></div><a href="{{ path('admin_orders') }}" class="card-link">View All →</a></div>
                <div class="table-wrapper"><table class="admin-table"><thead><tr><th>ORDER</th><th>CUSTOMER</th><th>TOTAL</th><th>STATUS</th><th>DATE</th></tr></thead><tbody>
                {% for order in recent_orders %}<tr><td><strong class="order-id">#{{ order.id }}</strong></td><td><div class="customer-cell"><strong>{{ order.customer_name }}</strong></div></td><td><strong>₱{{ order.total|number_format(2, '.', ',') }}</strong></td><td><span class="status-badge {{ order.status|lower|replace({' ': '-'}) }}">{{ order.status }}</span></td><td>{{ order.created_at|date('M d, Y') }}</td></tr>{% else %}<tr><td colspan="5">No orders yet.</td></tr>{% endfor %}
                </tbody></table></div>
            </div>
        </section>
    </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(() => {
 const salesRows={{ sales_trend|json_encode|raw }}, statusRows={{ order_status_rows|json_encode|raw }};
 const money=v=>'₱'+Number(v).toLocaleString('en-PH',{maximumFractionDigits:0});
 const c=document.getElementById('lbSalesChart');
 if(c&&window.Chart){const map=new Map(salesRows.map(r=>[r.day,Number(r.sales)])),labels=[],values=[];for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);const k=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');labels.push(d.toLocaleDateString('en-US',{month:'short',day:'numeric'}));values.push(map.get(k)||0);}new Chart(c,{type:'line',data:{labels,datasets:[{data:values,label:'Sales',borderColor:'#641c1c',backgroundColor:'rgba(255,145,0,.16)',fill:true,tension:.38,borderWidth:3,pointBackgroundColor:'#ff9100'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:x=>money(x.parsed.y)}}},scales:{x:{grid:{display:false}},y:{beginAtZero:true,ticks:{callback:money}}}}});}
 const o=document.getElementById('lbOrdersChart'), palette=['#641c1c','#ff9100','#6f8b3a','#292421','#d8b98c','#a65a36'];
 if(o&&window.Chart){new Chart(o,{type:'doughnut',data:{labels:statusRows.map(r=>r.status),datasets:[{data:statusRows.map(r=>Number(r.total)),backgroundColor:palette,borderColor:'#fffaf2',borderWidth:3,hoverOffset:6}]},options:{cutout:'70%',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});const l=document.getElementById('lbOrderLegend');statusRows.forEach((r,i)=>{const e=document.createElement('div');e.className='lb-legend-item';e.innerHTML='<span style="background:'+palette[i%palette.length]+'"></span><b></b><em></em>';e.querySelector('b').textContent=r.status;e.querySelector('em').textContent=r.total;l.appendChild(e);});}
})();
</script>
{% endblock %}
