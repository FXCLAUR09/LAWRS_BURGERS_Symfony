
{% extends 'base.html.twig' %}

{% block title %}About Us | Lawr's Burgers{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&family=Pacifico&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="{{ asset('css/style.css') }}"
    >
{% endblock %}

{% block body %}

<main class="about-page">

    <!-- ABOUT HERO -->

    <section class="about-hero">

        <div class="about-hero-content">

            <p class="about-script">
                get to know us
            </p>

            <h1>
                ABOUT <span>LAWR'S</span><br>
                BURGERS
            </h1>

            <p>
                Great burgers aren't just about what's between
                the buns. They're about fresh ingredients,
                bold flavors, and the passion behind every bite.
            </p>

        </div>

    </section>

    <!-- OUR STORY -->

    <section class="about-story">

        <div class="about-story-content">

            <p class="about-section-script">
                our story
            </p>

            <h2>
                REAL INGREDIENTS.<br>
                <span>SUPER'B TASTE!!</span>
            </h2>

            <p>
                At Lawr's Burgers, we believe that a great burger
                should be simple, satisfying, and full of flavor.
            </p>

            <p>
                That's why we focus on quality ingredients and
                burgers made to deliver a delicious experience
                from the first bite to the last.
            </p>

            <p>
                Our goal is simple: serve burgers that bring
                people together, create good memories, and
                always leave you craving another bite.
            </p>

            <a
                class="outline-btn small"
                href="{{ path('menu') }}"
            >
                TRY OUR BURGERS
            </a>

        </div>

        <div class="about-story-badge">

            <span>
                ★ ★ ★
            </span>

            <b>
                FRESH
            </b>

            <small>
                NEVER FROZEN
            </small>

            <span>
                ★
            </span>

        </div>

    </section>

    <!-- OUR VALUES -->

    <section class="about-values">

        <div class="about-values-heading">

            <p class="about-section-script">
                what we believe
            </p>

            <h2>
                OUR <span>VALUES</span>
            </h2>

        </div>

        <div class="about-values-grid">

            <article class="about-value-card">

                <div class="about-value-number">
                    01
                </div>

                <h3>
                    QUALITY
                </h3>

                <p>
                    We believe great food starts with
                    quality ingredients and careful
                    preparation.
                </p>

            </article>

            <article class="about-value-card">

                <div class="about-value-number">
                    02
                </div>

                <h3>
                    FLAVOR
                </h3>

                <p>
                    Every burger should have bold,
                    satisfying flavor that makes
                    every bite worth it.
                </p>

            </article>

            <article class="about-value-card">

                <div class="about-value-number">
                    03
                </div>

                <h3>
                    PEOPLE
                </h3>

                <p>
                    Good food is better when shared.
                    We're here to create great food
                    and good moments.
                </p>

            </article>

        </div>

    </section>

    <!-- BRAND STATEMENT -->

    <section class="about-statement">

        <p class="script">
            our promise
        </p>

        <h2>
            GOOD BURGERS.<br>
            <span>GOOD MOOD.</span>
        </h2>

        <p>
            From the ingredients we choose to the burgers
            we serve, Lawr's Burgers is all about creating
            a flavorful experience worth coming back for.
        </p>

    </section>

    <!-- ORDER CTA -->

    <section class="about-order">

        <div>

            <h2>
                CRAVING SOMETHING DELICIOUS?
            </h2>

            <p>
                ORDER NOW AND TASTE THE DIFFERENCE!
            </p>

        </div>

        <a
            class="dark-btn"
            href="{{ path('menu') }}"
        >
            ORDER NOW
        </a>

    </section>

</main>

<!-- FOOTER -->

<footer
    class="site-footer"
    id="contact"
>

    <div class="footer-main">

        <div class="footer-brand-area">

            <a
                class="footer-logo"
                href="{{ path('home') }}"
            >

                <span class="footer-logo-main">
                    LAWR’S
                </span>

                <span class="footer-logo-sub">
                    BURGERS
                </span>

            </a>

            <p class="footer-slogan">

                <br><br>

                GOOD BURGERS.<br>
                GOOD MOOD.

            </p>

            <p class="footer-description">

                Fresh burgers, bold flavors,<br>
                and good food made for everyone.

            </p>

            <div class="footer-socials">

                <a
                    href="#"
                    aria-label="Facebook"
                >
                    <img
                        src="{{ asset('assets/facebook.png') }}"
                        alt="Facebook"
                    >
                </a>

                <a
                    href="#"
                    aria-label="Instagram"
                >
                    <img
                        src="{{ asset('assets/instagram.png') }}"
                        alt="Instagram"
                    >
                </a>

                <a
                    href="#"
                    aria-label="X"
                >
                    <img
                        src="{{ asset('assets/x-icon.png') }}"
                        alt="X"
                    >
                </a>

            </div>

        </div>

        <div class="footer-links-area">

            <h3>
                QUICK LINKS
            </h3>

            <a href="{{ path('home') }}">
                Home
            </a>

            <a href="{{ path('menu') }}">
                Our Menu
            </a>

            <a href="{{ path('about') }}">
                About Us
            </a>

            <a href="{{ path('home') }}#identity">
                Gallery
            </a>

            <a href="/reviews">
                Reviews
            </a>

            <a href="{{ path('home') }}#contact">
                Contact
            </a>

        </div>

        <div class="footer-hours-area">

            <h3>
                HOURS
            </h3>

            <div class="footer-hour-group">

                <strong>
                    MON - FRI
                </strong>

                <span>
                    10:00 AM - 9:00 PM
                </span>

            </div>

            <div class="footer-hour-group">

                <strong>
                    SATURDAY
                </strong>

                <span>
                    10:00 AM - 10:00 PM
                </span>

            </div>

            <div class="footer-hour-group">

                <strong>
                    SUNDAY
                </strong>

                <span>
                    10:00 AM - 8:00 PM
                </span>

            </div>

        </div>

        <div class="footer-contact-area">

            <p class="footer-big-slogan">

                SAVOR THE<br>
                ULTIMATE <span>BURGER.</span>

            </p>

            <h3>
                CONTACT US
            </h3>

            <div class="footer-contact-item">

                <span class="footer-contact-icon">
                    ☎
                </span>

                <span>
                    +63 994 072 5885
                </span>

            </div>

            <div class="footer-contact-item">

                <span class="footer-contact-icon">
                    ✉
                </span>

                <span>
                    lawrsburgers@gmail.com
                </span>

            </div>

            <div class="footer-contact-item">

                <span class="footer-contact-icon">
                    📍
                </span>

                <span>
                    Dumaguete City,<br>
                    Negros Oriental, Philippines
                </span>

            </div>

        </div>

    </div>

    <div class="footer-bottom">

        <div class="footer-divider"></div>

        <p>
            © <span id="year">2026</span>
            Lawr’s Burgers. All Rights Reserved.
        </p>

    </div>

</footer>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/script.js') }}"></script>
{% endblock %}
