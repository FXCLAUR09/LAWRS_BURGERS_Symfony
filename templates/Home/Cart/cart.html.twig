
{% extends 'base.html.twig' %}

{% block title %}Your Cart - Lawr's Burgers{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&family=Pacifico&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/script.js') }}"></script>
{% endblock %}

{% block body %}

<main>
    <section class="cart-page">
        <div class="cart-container">

            <!-- PAGE HEADING -->
            <div class="cart-heading">
                <div>
                    <p class="script">your order</p>
                    <h1>SHOPPING CART</h1>
                    <p class="cart-subtitle">
                        Review your delicious choices before checkout.
                    </p>
                </div>

                <a href="{{ path('menu') }}" class="continue-btn">
                    ← CONTINUE SHOPPING
                </a>
            </div>

            {% if cart is empty %}

                <!-- EMPTY CART -->
                <div class="empty-cart">
                    <div class="empty-cart-icon">🛒</div>

                    <h2>YOUR CART IS EMPTY</h2>

                    <p>
                        Looks like you haven't added any burgers yet.
                    </p>

                    <a href="{{ path('menu') }}" class="checkout-btn">
                        VIEW OUR MENU
                    </a>
                </div>

            {% else %}

                <!-- CART ITEMS -->
                <div class="cart-items">

                    {% for item in cart %}

                        {% set itemId = item.id|default(0) %}
                        {% set itemName = item.name|default('Burger') %}
                        {% set itemPrice = item.price|default(0) %}
                        {% set itemQuantity = item.quantity|default(1) %}
                        {% set itemImage = item.image|default('') %}
                        {% set subtotal = itemPrice * itemQuantity %}

                        <article class="cart-item">

                            <!-- BURGER IMAGE -->
                            <div class="cart-item-image">

                                {% if itemImage is not empty %}

                                    <img
                                        src="{{ asset('assets/' ~ itemImage) }}"
                                        alt="{{ itemName }}"
                                    >

                                {% else %}

                                    <div class="cart-no-image">
                                        🍔
                                    </div>

                                {% endif %}

                            </div>

                            <!-- BURGER INFORMATION -->
                            <div class="cart-item-info">

                                <p class="cart-item-label">
                                    LAWR'S BURGERS
                                </p>

                                <h2>{{ itemName }}</h2>

                                <p class="cart-price">
                                    ₱{{ itemPrice|number_format(2, '.', ',') }}
                                    each
                                </p>

                            </div>

                            <!-- QUANTITY -->
                            <div class="cart-quantity">

                                <span class="cart-label">
                                    QUANTITY
                                </span>

                                <form
                                    action="{{ path('cart_update') }}"
                                    method="POST"
                                    class="quantity-form"
                                >

                                    <input
                                        type="hidden"
                                        name="burger_id"
                                        value="{{ itemId }}"
                                    >

                                    <input
                                        type="number"
                                        name="quantity"
                                        value="{{ itemQuantity }}"
                                        min="1"
                                        required
                                        aria-label="Quantity of {{ itemName }}"
                                    >

                                    <button
                                        type="submit"
                                        class="update-btn"
                                    >
                                        UPDATE
                                    </button>

                                </form>

                            </div>

                            <!-- SUBTOTAL -->
                            <div class="cart-item-total">

                                <span class="cart-label">
                                    SUBTOTAL
                                </span>

                                <strong>
                                    ₱{{ subtotal|number_format(2, '.', ',') }}
                                </strong>

                            </div>

                            <!-- REMOVE -->
                            <div class="cart-remove">

                                <a
                                    href="{{ path('cart_remove', {id: itemId}) }}"
                                    class="remove-btn"
                                    onclick="return confirm('Remove this burger from your cart?');"
                                >
                                    REMOVE
                                </a>

                            </div>

                        </article>

                    {% endfor %}

                </div>

                <!-- CART SUMMARY -->
                <div class="cart-summary">

                    <div class="cart-summary-left">
                        <p>
                            {{ cart|length }}
                            item{{ cart|length != 1 ? 's' : '' }}
                            in your cart
                        </p>
                    </div>

                    <div class="cart-summary-right">

                        <div class="cart-total">

                            <span>
                                TOTAL
                            </span>

                            <strong>
                                ₱{{ total|number_format(2, '.', ',') }}
                            </strong>

                        </div>

                        <div class="cart-actions">

                            <a
                                href="{{ path('menu') }}"
                                class="continue-btn"
                            >
                                CONTINUE SHOPPING
                            </a>

                            <a
                                href="{{ path('checkout') }}"
                                class="checkout-btn"
                            >
                                CHECKOUT →
                            </a>

                        </div>

                    </div>

                </div>

            {% endif %}

            <!-- VIEW MY ORDERS -->
            <section
                class="my-orders-section"
                id="my-orders"
                aria-labelledby="myOrdersTitle"
            >

                <div class="my-orders-heading">

                    <div>
                        <p class="my-orders-eyebrow">
                            YOUR ORDER HISTORY
                        </p>

                        <h2 id="myOrdersTitle">
                            VIEW MY ORDERS
                        </h2>

                        <p>
                            Track your recent orders and check their latest status.
                        </p>
                    </div>

                    {% if app.session.get('customer_id') and customer_orders is not empty %}

                        <a
                            class="checkout-btn orders-action-btn"
                            href="{{ path('cart') }}#my-orders"
                        >
                            REFRESH ORDERS ↻
                        </a>

                    {% endif %}

                </div>

                {% if not app.session.get('customer_id') %}

                    <div class="orders-empty-state">

                        <div class="orders-empty-icon">
                            📦
                        </div>

                        <h3>
                            Log in to view your orders
                        </h3>

                        <p>
                            Your placed orders and their latest statuses will appear here after you sign in.
                        </p>

                        <a
                            class="checkout-btn orders-action-btn"
                            href="{{ path('app_login') }}"
                        >
                            LOGIN TO VIEW ORDERS →
                        </a>

                    </div>

                {% elseif order_history_error %}

                    <p class="orders-error-note">
                        We couldn't load your order history right now.
                        Your cart is still available. Please refresh the page
                        or try again later.
                    </p>

                {% elseif customer_orders is empty %}

                    <div class="orders-empty-state">

                        <div class="orders-empty-icon">
                            🍔
                        </div>

                        <h3>
                            No orders yet
                        </h3>

                        <p>
                            Once you place an order, you can track its progress here.
                        </p>

                        <a
                            class="checkout-btn orders-action-btn"
                            href="{{ path('menu') }}"
                        >
                            BROWSE OUR MENU →
                        </a>

                    </div>

                {% else %}

                    <div class="orders-list">

                        {% for customerOrder in customer_orders %}

                            {% set displayStatus = customerOrder.status|default('Pending')|trim %}
                            {% set statusClass = displayStatus|lower|replace({' ': '-', '_': '-'}) %}
                            {% set createdAt = customerOrder.created_at ? customerOrder.created_at|date('M j, Y · g:i A') : 'Date unavailable' %}

                            <article class="order-history-card">

                                <div>

                                    <span class="order-history-label">
                                        Order Number
                                    </span>

                                    <div class="order-history-value">
                                        #{{ customerOrder.id }}
                                    </div>

                                    <span class="order-payment-note">
                                        {{ createdAt }}
                                    </span>

                                </div>

                                <div>

                                    <span class="order-history-label">
                                        Total
                                    </span>

                                    <div class="order-history-value">
                                        ₱{{ customerOrder.total|default(0)|number_format(2, '.', ',') }}
                                    </div>

                                    <span class="order-payment-note">
                                        {{ customerOrder.payment_method|default('Payment method unavailable') }}
                                    </span>

                                </div>

                                <div class="order-history-status">

                                    <span class="order-history-label">
                                        Order Status
                                    </span>

                                    <span class="order-status-pill status-{{ statusClass }}">
                                        {{ displayStatus }}
                                    </span>

                                    {% if customerOrder.payment_status %}

                                        <span class="order-payment-note">
                                            Payment: {{ customerOrder.payment_status }}
                                        </span>

                                    {% endif %}

                                </div>

                                {% if displayStatus|lower == 'completed' %}

                                    <div class="order-history-actions">

                                        <a
                                            class="checkout-btn orders-action-btn receipt-download-btn"
                                            href="/receipt.php?id={{ customerOrder.id }}"
                                            aria-label="Download receipt for order #{{ customerOrder.id }}"
                                        >
                                            DOWNLOAD RECEIPT ↓
                                        </a>

                                    </div>

                                {% endif %}

                            </article>

                        {% endfor %}

                    </div>

                {% endif %}

            </section>

        </div>
    </section>
</main>

<!-- FOOTER -->
<footer class="site-footer" id="contact">

    <div class="footer-main">

        <!-- BRAND -->
        <div class="footer-brand-area">

            <a class="footer-logo" href="{{ path('home') }}">

                <span class="footer-logo-main">
                    LAWR’S
                </span>

                <span class="footer-logo-sub">
                    BURGERS
                </span>

            </a>

            <p class="footer-slogan">
                <br><br>
                GOOD BURGERS.<br>
                GOOD MOOD.
            </p>

            <p class="footer-description">
                Fresh burgers, bold flavors,<br>
                and good food made for everyone.
            </p>

            <div class="footer-socials">

                <a href="#" aria-label="Facebook">
                    <img src="{{ asset('assets/facebook.png') }}" alt="Facebook">
                </a>

                <a href="#" aria-label="Instagram">
                    <img src="{{ asset('assets/instagram.png') }}" alt="Instagram">
                </a>

                <a href="#" aria-label="X">
                    <img src="{{ asset('assets/x-icon.png') }}" alt="X">
                </a>

            </div>

        </div>

        <!-- QUICK LINKS -->
        <div class="footer-links-area">

            <h3>
