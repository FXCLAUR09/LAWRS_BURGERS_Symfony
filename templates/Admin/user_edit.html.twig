<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Edit {{ type|title }} Account | Lawr's Burgers</title><link rel="stylesheet" href="{{ asset('css/admin.css') }}"><style>
.ue-panel{max-width:760px;background:#fff;border:1px solid #eee3d7;border-radius:16px;padding:26px;box-shadow:0 8px 24px #32170d0a}.ue-kicker{font-size:11px;font-weight:800;letter-spacing:1.5px;color:#d97916}.ue-panel h2{margin:5px 0 8px;color:#251713}.ue-note{font-size:13px;color:#81746b;margin-bottom:22px}.ue-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.ue-field{display:grid;gap:7px}.ue-field label{font-size:12px;font-weight:800;color:#51433a}.ue-field input{border:1px solid #e7ddd2;border-radius:9px;padding:12px}.ue-wide{grid-column:1/-1}.ue-actions{display:flex;gap:9px;margin-top:22px}.ue-btn{border:0;border-radius:9px;padding:11px 16px;background:#f28a18;color:#21150d;font-weight:800;text-decoration:none;cursor:pointer}.ue-btn.alt{background:#f4eee7;color:#4a3025}@media(max-width:650px){.ue-grid{grid-template-columns:1fr}.ue-wide{grid-column:auto}}
</style></head><body><div class="admin-layout">{% include 'Admin/sidebar.html.twig' %}<main class="admin-main"><header class="admin-topbar"><div><div class="breadcrumb">ADMIN / USERS / EDIT</div><h1>Edit {{ type|title }} Account</h1></div><div class="admin-user"><div class="user-avatar">{{ admin_username|first|upper }}</div><div class="user-info"><strong>{{ admin_username }}</strong><span>Administrator</span></div></div></header><section class="admin-content"><div class="ue-panel"><span class="ue-kicker">ACCOUNT SETTINGS</span><h2>{{ type == 'staff' ? account.name : account.username }}</h2><p class="ue-note">Update account details. Leave the new password blank to keep the current password.</p>{% for message in app.flashes('error') %}<div style="background:#fff0ed;color:#a12b20;padding:12px;border-radius:8px;margin-bottom:14px">{{ message }}</div>{% endfor %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('edit_' ~ type ~ '_' ~ account.id) }}"><div class="ue-grid">{% if type == 'staff' %}<div class="ue-field ue-wide"><label>FULL NAME</label><input name="name" required maxlength="100" value="{{ account.name }}"></div>{% endif %}<div class="ue-field"><label>USERNAME</label><input name="username" required minlength="3" maxlength="50" pattern="[A-Za-z0-9_-]+" value="{{ account.username }}"></div>{% if type == 'staff' %}<div class="ue-field"><label>EMAIL ADDRESS</label><input name="email" type="email" required maxlength="150" value="{{ account.email }}"></div>{% endif %}<div class="ue-field ue-wide"><label>NEW PASSWORD (OPTIONAL)</label><input name="password" type="password" minlength="8" maxlength="255" autocomplete="new-password" placeholder="Leave blank to keep current password"></div></div><div class="ue-actions"><button class="ue-btn" type="submit">Save Changes</button><a class="ue-btn alt" href="{{ path('admin_users_index') }}">Cancel</a></div></form></div></section></main></div></body></html>
